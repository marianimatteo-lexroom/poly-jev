# --- Jev / TypeSafe AI ---
# Create a key at https://console.typesafe.ai/keys (sign up at https://typesafe.ai)
TYPESAFE_API_KEY=
# Optional overrides — TypeSafeClient reads these itself; leave unset for defaults.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- Polymarket ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
# Public RPC verified working: https://polygon-bor-rpc.publicnode.com
# (polygon-rpc.com and several other "free public" RPCs were down/gated when
# this was tested on 2026-09-19 — swap this if it stops working for you.)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Never paste your private key into a chat with an AI assistant. Set this
# directly in your own .env / secrets manager.
POLYGON_WALLET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA (trading directly from the private key's own address).
# 1 = email/magic-link proxy wallet. 2 = browser-wallet (Gnosis Safe) proxy.
# If you funded your account through the Polymarket UI (not by importing a
# raw private key), you're almost certainly on 1 or 2 — check polygonscan
# for your deposit address vs. your signing key's address. See README.
POLYMARKET_SIGNATURE_TYPE=0

# --- Safety ---
# Reflex refuses to place real orders unless this is explicitly set to false.
DRY_RUN=true

# --- Universe: what counts as "short horizon" ---
MIN_HOURS_TO_RESOLUTION=0.5
MAX_HOURS_TO_RESOLUTION=48
MIN_LIQUIDITY_USD=2000
MIN_VOLUME_USD=5000

# --- Edge thresholds ---
MIN_EDGE=0.05
MIN_EDGE_CONFIDENCE=0.6
MAX_MANIPULATION_RISK=0.35

# --- Risk / bankroll management ---
BANKROLL_USD=1000
KELLY_FRACTION=0.25
MAX_POSITION_USD=50
MAX_POSITION_FRACTION=0.05
MAX_OPEN_POSITIONS=15
MAX_DAILY_LOSS_USD=100
MAX_MARKET_EXPOSURE_USD=50

# --- Loop cadence ---
SCAN_INTERVAL_SECONDS=300
MAX_MARKETS_PER_CYCLE=200
LEDGER_PATH=data/ledger.jsonl
