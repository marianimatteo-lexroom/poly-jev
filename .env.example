# --- Jev / TypeSafe AI ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# --- Polymarket ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
POLYGON_WALLET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# --- Safety ---
# Reflex refuses to place real orders unless this is explicitly set to false.
DRY_RUN=true

# --- Universe: what counts as "short horizon" ---
MIN_HOURS_TO_RESOLUTION=0.5
MAX_HOURS_TO_RESOLUTION=48
MIN_LIQUIDITY_USD=2000
MIN_VOLUME_USD=5000

# --- Edge thresholds ---
MIN_EDGE=0.05
MIN_EDGE_CONFIDENCE=0.6
MAX_MANIPULATION_RISK=0.35

# --- Risk / bankroll management ---
BANKROLL_USD=1000
KELLY_FRACTION=0.25
MAX_POSITION_USD=50
MAX_POSITION_FRACTION=0.05
MAX_OPEN_POSITIONS=15
MAX_DAILY_LOSS_USD=100
MAX_MARKET_EXPOSURE_USD=50

# --- Loop cadence ---
SCAN_INTERVAL_SECONDS=300
MAX_MARKETS_PER_CYCLE=200
LEDGER_PATH=data/ledger.jsonl
